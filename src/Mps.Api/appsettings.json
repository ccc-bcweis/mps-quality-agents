{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Mps": "Data Source=mps.db"
  },
  "Approval": {
    "LifetimeMinutes": 15
  },
  "Metrics": {
    "SpendCapUsd": 2.0,
    "CostPerInvestigationUsd": 0
  },
  "Mps": {
    "Auth": {
      "Mode": "local"
    },
    "Demo": {
      "Seed": 4242,
      "ResetDrainSeconds": 5
    },
    "Injector": {
      "DirectTicket": false
    },
    "Simulation": {
      "Enabled": true,
      "RealTime": true,
      "TickSeconds": 2,
      "SimSecondsPerWallSecond": 60,
      "PrimeSeconds": 600,
      "SampleStrideSeconds": 15,
      "PushIntervalMilliseconds": 1000,
      "ClockIntervalSeconds": 5,
      "MaxPushPointsPerSeries": 120
    },
    "Model": {
      "Mode": "",
      "TimeoutSeconds": 20,
      "CircuitBreakerFailures": 2,
      "CircuitCooldownSeconds": 60,
      "DailyCapUsd": 2,
      "InputUsdPerMillionTokens": 0.75,
      "OutputUsdPerMillionTokens": 4.50,
      "OpenAI": {
        "Model": "gpt-5.4-mini"
      },
      "ScriptedReplay": false,
      "Seed": 4242,
      "Temperature": 0
    }
  },
  "Otel": {
    "Enabled": true
  }
}
