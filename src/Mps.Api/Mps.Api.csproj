<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Mps.Api</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mps.Agents\Mps.Agents.csproj" />
    <ProjectReference Include="..\Mps.Application\Mps.Application.csproj" />
    <ProjectReference Include="..\Mps.Bus\Mps.Bus.csproj" />
    <ProjectReference Include="..\Mps.ModelGateway\Mps.ModelGateway.csproj" />
    <ProjectReference Include="..\Mps.Orchestration\Mps.Orchestration.csproj" />
    <ProjectReference Include="..\Mps.Connectors\Mps.Connectors.csproj" />
    <ProjectReference Include="..\Mps.Simulator\Mps.Simulator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Condition="Exists('..\..\eval\results\latest.json')" Include="..\..\eval\results\latest.json" Link="eval\latest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\data\fleet\*.yaml" Link="data\fleet\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Data.Tables" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>
</Project>
