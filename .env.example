# Copy this file to .env. .env is git-ignored. `dotnet run` and docker compose both read it.
# Leave a line blank to use the default. Never commit a key.

# ---- Model -------------------------------------------------------------------------------------------------
# offline (default): no key, no network. The agents run on the saved answers the replay eval scores.
# openai: the OpenAI API with OPENAI_API_KEY. azure: Azure OpenAI with Azure login / managed identity, or a key.
# Blank: openai when OPENAI_API_KEY is set, otherwise offline.
MODEL_MODE=

# openai mode. OPENAI_MODEL defaults to Mps:Model:OpenAI:Model in src/Mps.Api/appsettings.json.
# OPENAI_BASE_URL is only for an OpenAI-compatible endpoint other than api.openai.com.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# azure mode. Without AZURE_OPENAI_API_KEY the app signs in with `az login` (laptop) or the managed identity (Azure).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=

# ---- Sign-in -----------------------------------------------------------------------------------------------
# local (default): no sign-in, you are the admin. Keep it on localhost.
# azure: Entra sign-in through Container Apps Easy Auth (hosted only). Needs at least one admin email.
Mps__Auth__Mode=
ADMIN_EMAILS=
Mps__Auth__HomeTenantId=

# ---- Local run ---------------------------------------------------------------------------------------------
# Used by `dotnet run`. Compose sets the container's own values.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080
ConnectionStrings__Mps=Data Source=mps.db

# Approval signing key (hex, 32+ bytes). Blank in Development: a random key per run, so approvals do not survive a restart.
Mps__Approval__SigningKey=

# OpenTelemetry to the local Aspire dashboard (docker compose starts it). Compose points the API at the dashboard service.
OTEL_SERVICE_NAME=Mps.Api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18889
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Local Aspire dashboard OTLP key only. Compose uses local-dev-only when this is blank. Not a cloud credential.
ASPIRE_OTLP_API_KEY=
