# Copy this file to .env. .env is git-ignored. Leave every secret blank.
# Replay mode needs no model key. Live mode reads a key only from the untracked .env.
# The compose file substitutes local defaults when a value is empty.

# replay or live. Compose and the API default to replay.
LLM_MODE=replay

# Used by `dotnet run`. Compose sets the container listen address itself.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080

# Local SQLite path for `dotnet run`. Not a secret. Compose uses /tmp/mps.db inside the container.
ConnectionStrings__Mps=Data Source=mps.db

# OpenTelemetry. `dotnet run` on the host uses localhost. Compose points the API at the dashboard service.
OTEL_SERVICE_NAME=Mps.Api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18889
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Local Aspire dashboard OTLP key only. Compose uses local-dev-only when this is blank.
# That value is low entropy and is for the local dashboard container. It is not a cloud credential.
ASPIRE_OTLP_API_KEY=

# Azure OpenAI, live mode only. Leave blank.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_INVESTIGATION=
AZURE_OPENAI_DEPLOYMENT_RESOLUTION=

# OpenAI-compatible endpoint, live mode only. Leave blank.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Entra, hosted demo only. Leave blank. Do not put a client secret in git.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure SQL, hosted demo only. Leave blank. Local runs use SQLite. No password belongs here.
AZURE_SQL_CONNECTION_STRING=
