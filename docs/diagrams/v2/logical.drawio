height="568" as="geometry"/></mxCell><mxCell id="gM" value="Enterprise context" style="rounded=1;arcSize=3;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=24;fontStyle=1;fontColor=#334155;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1586" y="764" width="440" height="284" as="geometry"/></mxCell><mxCell id="gS" value="Data stores" style="rounded=1;arcSize=3;whiteSpace=wrap;fillColor=#E7F8EF;strokeColor=#047857;strokeWidth=2;fontSize=24;fontStyle=1;fontColor=#065F46;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2096" y="170" width="440" height="658" as="geometry"/></mxCell><mxCell id="gU" value="Experience" style="rounded=1;arcSize=3;whiteSpace=wrap;fillColor=#E7F7F4;strokeColor=#0F766E;strokeWidth=2;fontSize=24;fontStyle=1;fontColor=#115E59;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="2096" y="854" width="440" height="344" as="geometry"/></mxCell><mxCell id="gX" value="Publish and subscribe on the backbone" style="rounded=1;arcSize=3;whiteSpace=wrap;fillColor=#FFF6D8;strokeColor=#A16207;strokeWidth=2;fontSize=24;fontStyle=1;fontColor=#7A5C00;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="566" y="1270" width="1970" height="190" as="geometry"/></mxCell><mxCell id="e0" value="&lt;b&gt;&lt;font color=&quot;#1E3A8A&quot; style=&quot;font-size:22px&quot;&gt;Tool fleet, three plants *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Etch, deposition, strip, clean tools&lt;br&gt;Sensors via plant IoT gateways" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="76" y="226" width="400" height="124" as="geometry"/></mxCell><mxCell id="e1" value="&lt;b&gt;&lt;font color=&quot;#1E3A8A&quot; style=&quot;font-size:22px&quot;&gt;Offline instruments&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Oscilloscope, RF meter printouts&lt;br&gt;Upload telemetry, read and confirmed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="76" y="368" width="400" height="124" as="geometry"/></mxCell><mxCell id="e2" value="&lt;b&gt;&lt;font color=&quot;#1E3A8A&quot; style=&quot;font-size:22px&quot;&gt;Operator report&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Manual ticket with tool and sensor" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="76" y="510" width="400" height="94" as="geometry"/></mxCell><mxCell id="e3" value="&lt;b&gt;&lt;font color=&quot;#1E3A8A&quot; style=&quot;font-size:22px&quot;&gt;Quality and supplier events&lt;/font&gt;&lt;/b&gt;&lt;br&gt;QMS nonconformance, supplier notice" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="76" y="622" width="400" height="94" as="geometry"/></mxCell><mxCell id="e4" value="&lt;b&gt;&lt;font color=&quot;#1E3A8A&quot; style=&quot;font-size:22px&quot;&gt;Simulator control plane *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Scenarios, fault injection, hard and&lt;br&gt;soft reset, replay vs live" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D4ED8;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="76" y="734" width="400" height="124" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b&gt;&lt;font color=&quot;#7A5C00&quot; style=&quot;font-size:22px&quot;&gt;Telemetry stream *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Azure Event Hubs (IoT Hub ingress)&lt;br&gt;Partitioned by tool, ordered" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="586" y="226" width="400" height="124" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;&lt;font color=&quot;#7A5C00&quot; style=&quot;font-size:22px&quot;&gt;Command and event topics *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Azure Service Bus topics&lt;br&gt;System and application commands" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="586" y="368" width="400" height="124" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;&lt;font color=&quot;#7A5C00&quot; style=&quot;font-size:22px&quot;&gt;Message envelope&lt;/font&gt;&lt;/b&gt;&lt;br&gt;eventId, type, correlationId,&lt;br&gt;causationId, parentEventId,&lt;br&gt;sequence, source, site, tool, time,&lt;br&gt;payload, schema version" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="586" y="510" width="400" height="184" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;&lt;font color=&quot;#7A5C00&quot; style=&quot;font-size:22px&quot;&gt;Command catalog&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Defined as data: who may issue&lt;br&gt;it and which events it emits" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="586" y="712" width="400" height="124" as="geometry"/></mxCell><mxCell id="b4" value="&lt;b&gt;&lt;font color=&quot;#7A5C00&quot; style=&quot;font-size:22px&quot;&gt;Event log&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Append-only, indexed by correlation&lt;br&gt;Rebuilds every causal chain" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="586" y="854" width="400" height="124" as="geometry"/></mxCell><mxCell id="d0" value="&lt;b&gt;&lt;font color=&quot;#155E75&quot; style=&quot;font-size:22px&quot;&gt;SPC monitoring&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Control limits, Western Electric rules" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1096" y="226" width="400" height="94" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;&lt;font color=&quot;#155E75&quot; style=&quot;font-size:22px&quot;&gt;Business rules engine&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ticket creation, escalation, routing&lt;br&gt;Rules and process maps are data" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1096" y="338" width="400" height="124" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;&lt;font color=&quot;#155E75&quot; style=&quot;font-size:22px&quot;&gt;Lifecycle state machines&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Alert, ticket, investigation,&lt;br&gt;approval, CAPA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1096" y="480" width="400" height="124" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;&lt;font color=&quot;#155E75&quot; style=&quot;font-size:22px&quot;&gt;Evidence gate and grounding check&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Weak or conflicting evidence&lt;br&gt;escalates to a person" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1096" y="622" width="400" height="124" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;&lt;font color=&quot;#155E75&quot; style=&quot;font-size:22px&quot;&gt;Approval and action service&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Human approves before any CAPA" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7490;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1096" y="764" width="400" height="94" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b&gt;&lt;font color=&quot;#5B21B6&quot; style=&quot;font-size:22px&quot;&gt;Investigation orchestrator&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Microsoft Agent Framework" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1606" y="226" width="400" height="94" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;&lt;font color=&quot;#5B21B6&quot; style=&quot;font-size:22px&quot;&gt;Investigation agent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Read-only tools over enterprise&lt;br&gt;systems and documents below" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1606" y="338" width="400" height="124" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;&lt;font color=&quot;#5B21B6&quot; style=&quot;font-size:22px&quot;&gt;Resolution agent&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Ranks root cause, no tools" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1606" y="480" width="400" height="94" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;&lt;font color=&quot;#5B21B6&quot; style=&quot;font-size:22px&quot;&gt;Model gateway&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Routing, retries, daily spend cap&lt;br&gt;Azure OpenAI gpt-5.4-mini, replay" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6D28D9;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1606" y="592" width="400" height="124" as="geometry"/></mxCell><mxCell id="m0" value="&lt;b&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:22px&quot;&gt;Mocked enterprise systems&lt;/font&gt;&lt;/b&gt;&lt;br&gt;MES, QMS, PLM, ERP, maintenance" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1606" y="820" width="400" height="94" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;&lt;font color=&quot;#334155&quot; style=&quot;font-size:22px&quot;&gt;Document store *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SOPs, FMEA, bulletins, search index" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1606" y="932" width="400" height="94" as="geometry"/></mxCell><mxCell id="s0" value="&lt;b&gt;&lt;font color=&quot;#065F46&quot; style=&quot;font-size:22px&quot;&gt;Metadata store *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Company, site, capability, line, tool,&lt;br&gt;parameter, limits, rules, process maps&lt;br&gt;Relational (Azure SQL)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2116" y="226" width="400" height="154" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;&lt;font color=&quot;#065F46&quot; style=&quot;font-size:22px&quot;&gt;Telemetry store *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Time series (Azure Data Explorer)&lt;br&gt;Retention policy, fast windows" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2116" y="398" width="400" height="124" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;&lt;font color=&quot;#065F46&quot; style=&quot;font-size:22px&quot;&gt;Transaction store *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Alerts, tickets, investigations,&lt;br&gt;approvals, CAPA, audit (Azure SQL)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2116" y="540" width="400" height="124" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;&lt;font color=&quot;#065F46&quot; style=&quot;font-size:22px&quot;&gt;Causal graph *&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Event lineage and genealogy&lt;br&gt;Graph store, optional (Cosmos DB)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2116" y="682" width="400" height="124" as="geometry"/></mxCell><mxCell id="u0" value="&lt;b&gt;&lt;font color=&quot;#115E59&quot; style=&quot;font-size:22px&quot;&gt;Meridian FabOps console&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Sites, fleet, alerts, tickets,&lt;br&gt;investigation, approval, CAPA,&lt;br&gt;rules and process, causal trace" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2116" y="910" width="400" height="154" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;&lt;font color=&quot;#115E59&quot; style=&quot;font-size:22px&quot;&gt;Live push&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SignalR fed by bus subscriptions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F766E;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="2116" y="1082" width="400" height="94" as="geometry"/></mxCell><mxCell id="x0" value="&lt;b&gt;&lt;font color=&quot;#7A5C00&quot; style=&quot;font-size:22px&quot;&gt;Every layer is a bus participant&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Rules, SPC, lifecycle, agents, stores and live push subscribe to typed topics and publish results with causationId set to the triggering event,&lt;br&gt;so one fault command fans out into readings, alert, ticket, investigation steps, approval and CAPA, all on one correlationId." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A16207;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="586" y="1318" width="1930" height="124" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="e0" target="b0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="e1" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="e2" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="e3" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="e4" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b0" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="b1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#334155;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="d1" target="a0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="NOTES
* The running demo is intentionally thin. One Azure Container App, one replica, hosts the API, simulator and agents.
* Demo bus: in-process, same envelope and command catalog (ADR-008). Measured: 7-day nominal seed, 466,662 readings in 7 s (~66k events/s).
* Demo stores: metadata in YAML loaded at startup (ADR-009); telemetry, event log and transactions in SQLite; 7-day chart read under 1 ms.
* Demo tools: three simulated plants; only the Manufacturing capability is simulated. Document search runs in process.
Every telemetry reading, alert, ticket, investigation step, approval, CAPA and command travels through the event backbone." style="text;whiteSpace=wrap;fontSize=19;align=left;verticalAlign=top;strokeColor=#0B1B33;fillColor=#FFFFFF;spacing=12;" vertex="1" parent="1"><mxGeometry x="48" y="1486" width="1580" height="210" as="geometry"/></mxCell><mxCell id="tb" value="Meridian Precision Systems · FabOps
Logical architecture, target design
Draft 2026-10-15 · ARCH D 36 x 24 in" style="text;whiteSpace=wrap;fontSize=22;fontColor=#FAC400;fillColor=#0B1B33;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="1644" y="1486" width="900" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>