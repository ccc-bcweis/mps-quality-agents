<mxfile host="app.diagrams.net"><diagram name="Data model, entities and relationships"><mxGraphModel dx="2592" dy="1728" grid="1" gridSize="10" pageWidth="2592" pageHeight="1728" page="1"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="kick" value="DATA MODEL · BASELINE V2 · DRAFT" style="text;fontSize=22;fontStyle=1;fontColor=#7A5C00;align=left;" vertex="1" parent="1"><mxGeometry x="56" y="60" width="1200" height="36" as="geometry"/></mxCell><mxCell id="title" value="Data model, entities and relationships" style="text;fontSize=40;fontStyle=1;fontColor=#0B1B33;align=left;" vertex="1" parent="1"><mxGeometry x="56" y="96" width="1600" height="50" as="geometry"/></mxCell><mxCell id="gm" value="Metadata (durable, kept by every reset)" style="rounded=1;arcSize=3;whiteSpace=wrap;fillColor=#E7F8EF;strokeColor=#047857;strokeWidth=2;fontSize=24;fontStyle=1;fontColor=#065F46;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="56" y="170" width="950" height="1150" as="geometry"/></mxCell><mxCell id="gt" value="Transactions and telemetry (purged by hard reset)" style="rounded=1;arcSize=3;whiteSpace=wrap;fillColor=#FFF6D8;strokeColor=#A16207;strokeWidth=2;fontSize=24;fontStyle=1;fontColor=#7A5C00;verticalAlign=top;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1076" y="170" width="1460" height="1150" as="geometry"/></mxCell><mxCell id="company" value="&lt;b&gt;&lt;font color=&quot;#065F46&quot; style=&quot;font-size:22px&quot;&gt;Company&lt;/font&gt;&lt;/b&gt;&lt;br&gt;name, purpose, industry&lt;br&gt;description" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#047857;strokeWidth=2;fontSize=18;align=left;verticalAlign=top;spacingLeft=14;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="76" y="230" width="400" height="120" as="geometry"/></mxCell><mxCell id="site" value="&lt;b&gt;&lt;font color=&quot;#065F46&quot; style=&quot;font-size:22px&quot;&gt;Site&lt;/font&gt;&lt;/b&gt;&lt;br&g