{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.meridian-precision.example/metadata/process-maps.schema.json",
  "title": "ProcessMapsFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["processMaps"],
  "properties": {
    "processMaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "state", "steps", "transitions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "enum": ["current", "future"] },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/step" }
          },
          "transitions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/transition" }
          }
        }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order", "highlightStages"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "highlightStages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["TicketOpened", "Investigating", "RecommendationReady", "Escalated", "AwaitingApproval", "Approved", "Rejected", "Closed"]
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "name"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
