{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.meridian-precision.example/metadata/capabilities.schema.json",
  "title": "CapabilitiesMetadataFile",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "siteId", "name", "type", "description", "simulated"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "siteId": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "type": "string",
            "enum": ["Manufacturing", "Warehousing", "ResearchAndDevelopment", "Sales", "BackOffice", "Other"]
          },
          "description": { "type": "string", "minLength": 1 },
          "simulated": { "type": "boolean" }
        }
      }
    }
  }
}
