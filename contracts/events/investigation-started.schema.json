{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.meridian-precision.example/events/investigation-started.schema.json",
  "title": "InvestigationStarted",
  "description": "An investigation started for one incident.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "investigationStarted" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["investigationId", "incidentId", "stage"],
      "properties": {
        "investigationId": { "type": "string", "format": "uuid" },
        "incidentId": { "type": "string", "format": "uuid" },
        "stage": { "const": "started" }
      }
    }
  }
}
