{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.meridian-precision.example/events/capa-advanced.schema.json",
  "title": "CapaAdvanced",
  "description": "A CAPA moved one stage forward. Stages do not skip and do not move backward in this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "capaAdvanced" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capaId", "fromStage", "toStage"],
      "properties": {
        "capaId": { "type": "string", "format": "uuid" },
        "fromStage": {
          "enum": ["open", "containment", "rootCauseConfirmed", "correctiveAction", "verification"]
        },
        "toStage": {
          "enum": ["containment", "rootCauseConfirmed", "correctiveAction", "verification", "closed"]
        }
      }
    }
  }
}
