{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.meridian-precision.example/events/evidence-gathered.schema.json",
  "title": "EvidenceGathered",
  "description": "The investigation recorded one or more evidence items. Evidence ids are stable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "evidenceGathered" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["investigationId", "incidentId", "evidence"],
      "properties": {
        "investigationId": { "type": "string", "format": "uuid" },
        "incidentId": { "type": "string", "format": "uuid" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source", "title", "excerpt", "observedAt"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "source": {
                "enum": ["telemetry", "spc", "mes", "qms", "plm", "erp", "cmms", "document", "ticketing", "manualMeasurement"]
              },
              "title": { "type": "string", "minLength": 1 },
              "excerpt": { "type": "string" },
              "observedAt": { "type": "string", "format": "date-time" },
              "toolId": { "type": ["string", "null"] },
              "externalRef": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
