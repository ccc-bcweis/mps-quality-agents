{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "mps-quality-agents-brand",
    "version": "1.0.0",
    "copyright": "Copyright (c) 2026 Bryan C. Weis and Common Consulting Company",
    "license": "MIT",
    "notes": "Two layers: StatusNeo pitch shell (deck framing) and Meridian Precision Systems console (demo app). StatusNeo gold #FAC400 is taken from public site CSS, not from logo artwork. Do not ship StatusNeo logo files."
  },
  "layers": {
    "statusneo": {
      "usage": "Deck title/closing slides, 'Prepared for Meridian Precision Systems' lockup, console footer wordmark. Text wordmark only until Bryan supplies official artwork.",
      "logo": {
        "mode": "placeholder-wordmark",
        "artwork": "Do not reproduce StatusNeo logo artwork. Use the dashed placeholder in logo-sheet.html / deck templates."
      },
      "color": {
        "navy": { "hex": "#0B1B33", "role": "pitch primary dark, title plates" },
        "navySoft": { "hex": "#1A2744", "role": "secondary navy on light" },
        "gold": { "hex": "#FAC400", "role": "accent only; never body text on white" },
        "goldInk": { "hex": "#7A5C00", "role": "gold-colored text on light backgrounds" },
        "goldWash": { "hex": "#F3E8C2", "role": "gold wash on navy" },
        "paper": { "hex": "#F7F4EA", "role": "pitch slide background" },
        "ink": { "hex": "#111827", "role": "body text on paper/white" },
        "muted": { "hex": "#4B5563", "role": "captions on paper/white" },
        "white": { "hex": "#FFFFFF", "role": "reverse text on navy" }
      },
      "typography": {
        "sans": {
          "family": "IBM Plex Sans",
          "fallback": ["IBM Plex Sans", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"],
          "source": "https://fonts.google.com/specimen/IBM+Plex+Sans",
          "license": "SIL Open Font License 1.1",
          "weights": [400, 500, 600, 700]
        },
        "serif": {
          "family": "IBM Plex Serif",
          "fallback": ["IBM Plex Serif", "Georgia", "Times New Roman", "serif"],
          "source": "https://fonts.google.com/specimen/IBM+Plex+Serif",
          "license": "SIL Open Font License 1.1",
          "weights": [400, 600],
          "role": "optional deck title accent"
        }
      },
      "typeRamp": {
        "deckTitle": { "sizePx": 36, "weight": 600, "lineHeight": 1.15, "family": "sans" },
        "deckSection": { "sizePx": 22, "weight": 600, "lineHeight": 1.25, "family": "sans" },
        "body": { "sizePx": 16, "weight": 400, "lineHeight": 1.45, "family": "sans" },
        "caption": { "sizePx": 12, "weight": 400, "lineHeight": 1.4, "family": "sans" },
        "footer": { "sizePx": 10, "weight": 400, "lineHeight": 1.35, "family": "sans" }
      }
    },
    "mps": {
      "usage": "Fab operations console (the demo app). Dark control-room look.",
      "color": {
        "canvas": { "hex": "#0E1116", "role": "app background" },
        "panel": { "hex": "#1A1F27", "role": "cards, sidebars, tiles" },
        "raised": { "hex": "#252B35", "role": "inset wells, chart plots, hover" },
        "line": { "hex": "#3D4654", "role": "borders, gridlines" },
        "text": { "hex": "#F8FAFC", "role": "primary text" },
        "textSecondary": { "hex": "#E5E7EB", "role": "secondary text" },
        "muted": { "hex": "#94A3B8", "role": "meta, timestamps, axis labels" },
        "nominal": { "hex": "#22D3EE", "role": "cyan: in-control, live, selected" },
        "nominalSoft": { "hex": "#67E8F9", "role": "sparklines, σ1 band" },
        "warn": { "hex": "#F59E0B", "role": "amber: warning, WE rule approaching" },
        "warnSoft": { "hex": "#FCD34D", "role": "σ2 band" },
        "alarm": { "hex": "#EF4444", "role": "red: alarm LED, σ3, open incident" },
        "alarmText": { "hex": "#FECACA", "role": "alarm copy on canvas" },
        "alarmSolid": { "hex": "#B91C1C", "role": "solid alarm button fill (white text)" },
        "ok": { "hex": "#10B981", "role": "green: approved, closed, in-spec" },
        "okSolid": { "hex": "#047857", "role": "solid approve button fill (white text)" },
        "ai": { "hex": "#A78BFA", "role": "violet: probabilistic / agent traces (distinct from rules)" },
        "rules": { "hex": "#22D3EE", "role": "deterministic logic callouts" }
      },
      "typography": {
        "ui": {
          "family": "Inter",
          "fallback": ["Inter", "Segoe UI", "system-ui", "sans-serif"],
          "source": "https://fonts.google.com/specimen/Inter",
          "license": "SIL Open Font License 1.1",
          "weights": [400, 500, 600, 700]
        },
        "mono": {
          "family": "JetBrains Mono",
          "fallback": ["JetBrains Mono", "Cascadia Code", "Consolas", "ui-monospace", "monospace"],
          "source": "https://fonts.google.com/specimen/JetBrains+Mono",
          "license": "SIL Open Font License 1.1",
          "weights": [400, 500, 600],
          "role": "IDs, values, timestamps, traces, JSON"
        }
      },
      "typeRamp": {
        "display": { "sizePx": 22, "weight": 600, "lineHeight": 1.2, "family": "ui" },
        "title": { "sizePx": 16, "weight": 600, "lineHeight": 1.3, "family": "ui" },
        "body": { "sizePx": 13, "weight": 400, "lineHeight": 1.4, "family": "ui" },
        "label": { "sizePx": 11, "weight": 500, "lineHeight": 1.3, "family": "ui", "tracking": "0.04em" },
        "value": { "sizePx": 13, "weight": 500, "lineHeight": 1.2, "family": "mono" },
        "kpi": { "sizePx": 20, "weight": 600, "lineHeight": 1.1, "family": "mono" },
        "micro": { "sizePx": 10, "weight": 500, "lineHeight": 1.2, "family": "mono" }
      }
    }
  },
  "contrast": {
    "method": "WCAG 2.x relative luminance",
    "aaNormal": 4.5,
    "aaLarge": 3.0,
    "aaaNormal": 7.0,
    "pairs": [
      { "fg": "#F8FAFC", "bg": "#0E1116", "ratio": 18.08, "level": "AAA", "use": "MPS body text on canvas" },
      { "fg": "#E5E7EB", "bg": "#0E1116", "ratio": 15.27, "level": "AAA", "use": "MPS secondary text on canvas" },
      { "fg": "#94A3B8", "bg": "#0E1116", "ratio": 7.38, "level": "AAA", "use": "MPS muted text on canvas" },
      { "fg": "#F8FAFC", "bg": "#1A1F27", "ratio": 15.81, "level": "AAA", "use": "MPS body text on panel" },
      { "fg": "#94A3B8", "bg": "#1A1F27", "ratio": 6.45, "level": "AA", "use": "MPS muted text on panel" },
      { "fg": "#22D3EE", "bg": "#0E1116", "ratio": 10.46, "level": "AAA", "use": "nominal / links on canvas" },
      { "fg": "#22D3EE", "bg": "#1A1F27", "ratio": 9.16, "level": "AAA", "use": "nominal on panel" },
      { "fg": "#F59E0B", "bg": "#0E1116", "ratio": 8.81, "level": "AAA", "use": "warn text on canvas" },
      { "fg": "#EF4444", "bg": "#0E1116", "ratio": 5.03, "level": "AA", "use": "alarm text on canvas; not AAA" },
      { "fg": "#FECACA", "bg": "#0E1116", "ratio": 13.07, "level": "AAA", "use": "alarm copy when small type" },
      { "fg": "#10B981", "bg": "#0E1116", "ratio": 7.46, "level": "AAA", "use": "ok / closed on canvas" },
      { "fg": "#0E1116", "bg": "#22D3EE", "ratio": 10.46, "level": "AAA", "use": "ink on cyan chip" },
      { "fg": "#0E1116", "bg": "#F59E0B", "ratio": 8.81, "level": "AAA", "use": "ink on amber chip" },
      { "fg": "#0E1116", "bg": "#EF4444", "ratio": 5.03, "level": "AA", "use": "ink on alarm chip" },
      { "fg": "#FFFFFF", "bg": "#B91C1C", "ratio": 6.47, "level": "AA", "use": "white label on solid alarm button" },
      { "fg": "#FFFFFF", "bg": "#047857", "ratio": 5.48, "level": "AA", "use": "white label on solid approve button" },
      { "fg": "#FFFFFF", "bg": "#0B1B33", "ratio": 17.23, "level": "AAA", "use": "StatusNeo reverse text on navy" },
      { "fg": "#FAC400", "bg": "#0B1B33", "ratio": 10.63, "level": "AAA", "use": "StatusNeo gold accent on navy" },
      { "fg": "#0B1B33", "bg": "#FAC400", "ratio": 10.63, "level": "AAA", "use": "navy wordmark on gold plate" },
      { "fg": "#111827", "bg": "#FFFFFF", "ratio": 17.74, "level": "AAA", "use": "StatusNeo body on white" },
      { "fg": "#111827", "bg": "#F7F4EA", "ratio": 16.5, "level": "AAA", "use": "StatusNeo body on paper (approx)" },
      { "fg": "#4B5563", "bg": "#FFFFFF", "ratio": 7.56, "level": "AAA", "use": "StatusNeo muted on white" },
      { "fg": "#7A5C00", "bg": "#FFFFFF", "ratio": 6.25, "level": "AA", "use": "StatusNeo gold-ink on white" }
    ],
    "doNotUse": [
      { "fg": "#FAC400", "bg": "#FFFFFF", "ratio": 1.62, "reason": "StatusNeo gold fails AA as body text on white. Use goldInk #7A5C00 or gold on navy." },
      { "fg": "#FFFFFF", "bg": "#EF4444", "ratio": 3.76, "reason": "White on alarm red is AA-large only. Use alarmSolid #B91C1C or ink #0E1116 on #EF4444." },
      { "fg": "#6B7280", "bg": "#0E1116", "ratio": 3.91, "reason": "Gray-500 on canvas fails AA for small text. Use muted #94A3B8." }
    ]
  },
  "space": {
    "unitPx": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64]
  },
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 4,
    "lg": 8,
    "pill": 999
  },
  "shadow": {
    "panel": "0 1px 0 rgba(255,255,255,0.04), 0 8px 24px rgba(0,0,0,0.35)",
    "overlay": "0 16px 48px rgba(0,0,0,0.55)"
  },
  "motion": {
    "fastMs": 120,
    "medMs": 200,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "z": {
    "base": 0,
    "sticky": 20,
    "banner": 30,
    "nav": 40,
    "overlay": 50,
    "toast": 60
  },
  "semantic": {
    "lifecycle": {
      "alert": { "color": "alarm", "label": "Alert" },
      "ticket": { "color": "warn", "label": "Ticket" },
      "investigation": { "color": "nominal", "label": "Investigation" },
      "recommendation": { "color": "ai", "label": "Recommendation" },
      "approval": { "color": "warn", "label": "Approval" },
      "capa": { "color": "ok", "label": "CAPA" }
    },
    "severity": {
      "nominal": { "led": "nominal", "label": "NOMINAL" },
      "watch": { "led": "warn", "label": "WATCH" },
      "alarm": { "led": "alarm", "label": "ALARM" },
      "closed": { "led": "ok", "label": "CLOSED" }
    },
    "mode": {
      "live": { "bg": "#047857", "fg": "#FFFFFF", "label": "LIVE AI" },
      "replay": { "bg": "#1A2744", "fg": "#FAC400", "label": "REPLAY MODE" },
      "mockReasoner": { "bg": "#1A1F27", "fg": "#A78BFA", "label": "MOCK REASONER" }
    }
  },
  "fleet": {
    "families": [
      { "id": "D7", "name": "MPS-D7", "process": "thin-film deposition (PECVD/PVD)", "accent": "#22D3EE" },
      { "id": "E7", "name": "MPS-E7", "process": "plasma etch", "accent": "#67E8F9" },
      { "id": "S7", "name": "MPS-S7", "process": "photoresist strip (ash)", "accent": "#F59E0B" },
      { "id": "C7", "name": "MPS-C7", "process": "single-wafer clean", "accent": "#10B981" }
    ],
    "namingRule": "Fictional tool families only. Never use real equipment-vendor product names."
  }
}
